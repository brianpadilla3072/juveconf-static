---
export const prerender = true;

import TeamRegistration from '../components/TeamRegistration';
import '../styles/global.css';

// URL: /equipos            -> inscribir un equipo nuevo
// URL: /equipos?id=&token= -> editar un equipo ya inscripto (link privado del líder)
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/icon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<title>Inscripción de equipos - JUVECONFE</title>
		<meta name="description" content="Inscribí a tu equipo en JUVECONFE" />
	</head>
	<body class="min-h-screen bg-black">
		<TeamRegistration client:only="react" />
	</body>
</html>
