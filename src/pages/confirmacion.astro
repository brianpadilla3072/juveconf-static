---
// Pre-renderizar esta página estática en build time
export const prerender = true;

import '../styles/global.css';
import OrderSuccessWrapper from '../components/OrderSuccessWrapper.tsx';

// Esta página maneja la confirmación de orden
// URL: /confirmacion?orderId=xxx
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/icon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width" />
		<title>Confirmación de Orden - JUVECONFE</title>
		<meta name="description" content="Tu orden ha sido registrada exitosamente" />
		<meta name="robots" content="noindex, nofollow" />
	</head>
	<body class="min-h-screen bg-black">
		<OrderSuccessWrapper client:only="react" />
	</body>
</html>
